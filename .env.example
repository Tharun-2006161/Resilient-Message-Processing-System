# ──────────────────────────────────────────────
# Galactic Message Relay — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and adjust as needed.

# ── RabbitMQ ─────────────────────────────────
RABBITMQ_USER=galaxy
RABBITMQ_PASS=starfleet
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── Redis ────────────────────────────────────
REDIS_PORT=6379

# ── Producer ─────────────────────────────────
PRODUCER_PORT=3000

# ── Queues ───────────────────────────────────
PRIMARY_QUEUE=primary_queue
POISON_QUEUE=poison_queue

# ── Consumer ─────────────────────────────────
MAX_RETRIES=3
